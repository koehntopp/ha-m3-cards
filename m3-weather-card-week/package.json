{
  "name": "m3-weather-card-week",
  "version": "1.0.0",
  "description": "A Material 3 weekly forecast card for Home Assistant — one row per day, or the whole week in one row.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "lint": "tsc --noEmit && eslint src",
    "test": "vitest run",
    "test:contrast": "esbuild src/shared/contrast.ts --format=esm --outfile=.contrast.mjs --log-level=error && node test/contrast.test.mjs $PWD/.contrast.mjs; rm -f .contrast.mjs"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "hacs",
    "weather",
    "material-design"
  ],
  "license": "MIT",
  "author": "Frank Köhntopp",
  "repository": {
    "type": "git",
    "url": "https://github.com/koehntopp/m3-weather-card-week.git"
  },
  "homepage": "https://github.com/koehntopp/m3-weather-card-week",
  "bugs": {
    "url": "https://github.com/koehntopp/m3-weather-card-week/issues"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.11",
    "vitest": "^5.1.2"
  }
}
